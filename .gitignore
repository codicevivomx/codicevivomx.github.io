# Secretos
.env
.env.*

# Dependencias
node_modules/

# Caché de HyperFrames (checks, snapshots, vista previa, miniaturas)
.hyperframes/
.thumbnails/

# Videos renderizados (pesados; se suben a TikTok, no al repo)
*.mp4
*.mov
# Excepción: los MP4 ligeros (720p, ~9 MB) que el reproductor de retos usa en celular
!assets/video/*.mp4

# Configuración local de Claude Code
.claude/settings.local.json

# Sistema
Thumbs.db
.DS_Store
.claude/skills/

# Caché de ondas de audio de HyperFrames
.waveform-cache/

# renders intermedios de la mesa (las salidas son los .webp de plantilla/modelos/mesa/)
plantilla/modelos/mesa/fuentes/*.png
